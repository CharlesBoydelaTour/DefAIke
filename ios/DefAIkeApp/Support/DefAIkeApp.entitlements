<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container for the consented Share Extension handoff. The
	     container path is resolved through FileManager and never constructed by
	     hand. DEFAIKE_APP_GROUP_ID is defined once in ios/project.yml. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEFAIKE_APP_GROUP_ID)</string>
	</array>
</dict>
</plist>
