      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Tĥē ţŵō çĥēçkş àbōvē pōīņţ īņ ďīffēŗēņţ ďīŗēçţīōņş. Bōţĥ àŗē şĥōŵņ ēxàçţľý àş ţĥēý ŵēŗē fōūņď. Tĥīş àpp ďōēş ņōţ ďēçīďē bēţŵēēņ ţĥēm.]"
