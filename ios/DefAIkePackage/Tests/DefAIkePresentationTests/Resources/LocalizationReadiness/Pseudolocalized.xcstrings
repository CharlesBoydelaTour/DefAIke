    "copy.evidence-scope": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Tĥīş àpp ľōōkş fōŗ şīģņş ţĥàţ àņ ēņţīŗē īmàģē ŵàş ģēņēŗàţēď. Īţ ďōēş ņōţ ďēţēçţ ēďīţēď ŗēģīōņş, çōmpōşīţēş, fàçē şŵàpş, ŗēţōūçĥīņģ, vīďēō, ōŗ àūďīō, àņď īţ ďōēş ņōţ īďēņţīfý ŵĥīçĥ ţōōľ ŵàş ūşēď.]"
          }
        }
      }
    },
    "copy.false-result-limitation": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Bōţĥ kīņďş ōf mīşţàkē ĥàppēņ. À ŗēàľ pĥōţōģŗàpĥ çàņ bē ŗēpōŗţēď àş şĥōŵīņģ ÀĪ şīģņàľş, àņď àņ ÀĪ-ģēņēŗàţēď īmàģē çàņ bē ŗēpōŗţēď àş şĥōŵīņģ ņōņē. Ďō ņōţ ŗēľý ōņ ţĥīş ŗēşūľţ ōņ īţş ōŵņ.]"
          }
        }
      }
    },
    "copy.model-information": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Oņē mōďēľ ŗūņş ōņ ýōūŗ ďēvīçē. Īţ īş ņōţ pēŗfēçţ, àņď īţ īş ņēvēŗ ūpďàţēď ōvēŗ ţĥē ņēţŵōŗk.]"
          }
        }
      }
    },
    "copy.pixel-explanation.no-strong-signal-detected": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Tĥīş àpp ďīď ņōţ fīņď ţĥē pàţţēŗņş īţ ľōōkş fōŗ. Tĥàţ īş ņōţ à fīņďīņģ ţĥàţ ţĥē īmàģē īş ŗēàľ ōŗ ūņēďīţēď. Rēşàvīņģ, çŗōppīņģ, ōŗ şçŗēēņşĥōţţīņģ àņ īmàģē çàņ ŗēmōvē ţĥōşē pàţţēŗņş, şō àņ ÀĪ-ģēņēŗàţēď īmàģē çàņ àľşō ľōōk ľīkē ţĥīş.]"
          }
        }
      }
    },
    "copy.pixel-explanation.not-enough-signal": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Tĥēŗē ŵàş ņōţ ēņōūģĥ ūşàbľē şīģņàľ īņ ţĥīş īmàģē ţō ŗēpōŗţ ēīţĥēŗ ŵàý. Hēàvý çōmpŗēşşīōņ, à şmàľľ īmàģē, ōŗ à şçŗēēņşĥōţ çàņ àľľ çàūşē ţĥīş.]"
          }
        }
      }
    },
    "copy.pixel-explanation.signals-consistent-with-ai-generation": {
      "extractionState": "manual",
      "localizations": {
        "en-x-pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "[Tĥīş īmàģē çōņţàīņş pàţţēŗņş ţĥàţ ōfţēņ àppēàŗ īņ īmàģēş ģēņēŗàţēď ēņţīŗēľý bý ÀĪ. Tĥàţ īş ņōţ pŗōōf ōf ĥōŵ īţ ŵàş màďē. Tĥīş àpp çàņņōţ ţēľľ ýōū ŵĥō màďē īţ, ŵĥàţ īţ ŵàş màďē fōŗ, ōŗ ŵĥēţĥēŗ àņý pàŗţ ōf īţ ŵàş ēďīţēď.]"
