    "copy.evidence-scope": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This app looks for signs that an entire image was generated. It does not detect edited regions, composites, face swaps, retouching, video, or audio, and it does not identify which tool was used. · This app looks for signs that an entire image was generated. It does not detect edited regions, composites, face swaps, retouching, video, or audio, and it does not identify which tool was used.⟧"
          }
        }
      }
    },
    "copy.false-result-limitation": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Both kinds of mistake happen. A real photograph can be reported as showing AI signals, and an AI-generated image can be reported as showing none. Do not rely on this result on its own. · Both kinds of mistake happen. A real photograph can be reported as showing AI signals, and an AI-generated image can be reported as showing none. Do not rely on this result on its own.⟧"
          }
        }
      }
    },
    "copy.model-information": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦One model runs on your device. It is not perfect, and it is never updated over the network. · One model runs on your device. It is not perfect, and it is never updated over the network.⟧"
          }
        }
      }
    },
    "copy.pixel-explanation.no-strong-signal-detected": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This app did not find the patterns it looks for. That is not a finding that the image is real or unedited. Resaving, cropping, or screenshotting an image can remove those patterns, so an AI-generated image can also look like this. · This app did not find the patterns it looks for. That is not a finding that the image is real or unedited. Resaving, cropping, or screenshotting an image can remove those patterns, so an AI-generated image can also look like this.⟧"
          }
        }
      }
    },
    "copy.pixel-explanation.not-enough-signal": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦There was not enough usable signal in this image to report either way. Heavy compression, a small image, or a screenshot can all cause this. · There was not enough usable signal in this image to report either way. Heavy compression, a small image, or a screenshot can all cause this.⟧"
          }
        }
      }
    },
    "copy.pixel-explanation.signals-consistent-with-ai-generation": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This image contains patterns that often appear in images generated entirely by AI. That is not proof of how it was made. This app cannot tell you who made it, what it was made for, or whether any part of it was edited. · This image contains patterns that often appear in images generated entirely by AI. That is not proof of how it was made. This app cannot tell you who made it, what it was made for, or whether any part of it was edited.⟧"
          }
        }
      }
    },
