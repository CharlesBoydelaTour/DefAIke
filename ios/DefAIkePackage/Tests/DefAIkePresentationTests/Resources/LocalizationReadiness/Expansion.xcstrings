    "copy.provenance-state.absent": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This image carries no Content Credential. Most images do not, so this says nothing about how the image was made. · This image carries no Content Credential. Most images do not, so this says nothing about how the image was made.⟧"
          }
        }
      }
    },
    "copy.provenance-state.indeterminate": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This app could not finish checking this image's Content Credential, so there is no result from that source. · This app could not finish checking this image's Content Credential, so there is no result from that source.⟧"
          }
        }
      }
    },
    "copy.provenance-state.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
