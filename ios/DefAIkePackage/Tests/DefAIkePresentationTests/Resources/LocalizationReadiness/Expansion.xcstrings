    "copy.privacy-explanation": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Your image is analysed on this device. It is never uploaded, saved, or shared. · Your image is analysed on this device. It is never uploaded, saved, or shared.⟧"
