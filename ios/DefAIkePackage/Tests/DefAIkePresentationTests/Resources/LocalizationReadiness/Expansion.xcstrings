      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Development build. Its calibration is not approved, so nothing below is a verdict about any image. · Development build. Its calibration is not approved, so nothing below is a verdict about any image.⟧"
