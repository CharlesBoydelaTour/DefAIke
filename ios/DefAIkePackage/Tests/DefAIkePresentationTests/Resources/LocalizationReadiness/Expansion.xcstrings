{
  "sourceLanguage": "en-x-expand",
  "strings": {
    "copy.analysis-error.calibration-input-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The result could not be turned into one of this app's three labels, so no result is being shown. · The result could not be turned into one of this app's three labels, so no result is being shown.⟧"
          }
        }
      }
    },
    "copy.analysis-error.decoding-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦That image could not be read. The file may be incomplete or damaged. · That image could not be read. The file may be incomplete or damaged.⟧"
          }
        }
      }
    },
    "copy.analysis-error.handoff-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The image shared from the other app did not arrive intact, so it was not analysed. · The image shared from the other app did not arrive intact, so it was not analysed.⟧"
          }
        }
      }
    },
    "copy.analysis-error.inference-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The analysis did not finish running on this device, so no result was produced. · The analysis did not finish running on this device, so no result was produced.⟧"
          }
        }
      }
    },
    "copy.analysis-error.invalid-output-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The model returned something this app could not use, so no result is being shown. · The model returned something this app could not use, so no result is being shown.⟧"
          }
        }
      }
    },
    "copy.analysis-error.model-load-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The on-device model could not be loaded, so no analysis ran. · The on-device model could not be loaded, so no analysis ran.⟧"
          }
        }
      }
    },
    "copy.analysis-error.preprocessing-error": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The image could not be prepared for analysis, so no result was produced. · The image could not be prepared for analysis, so no result was produced.⟧"
          }
        }
      }
    },
    "copy.analysis-error.resource-limit": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Analysis stopped because it needed more memory or time than this app is allowed to use on this device. · Analysis stopped because it needed more memory or time than this app is allowed to use on this device.⟧"
          }
        }
      }
    },
    "copy.analysis-error.unsupported-media": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦That file is not a still image, so there was nothing for this app to analyse. · That file is not a still image, so there was nothing for this app to analyse.⟧"
          }
        }
      }
    },
    "copy.analysis-error.unsupported-static-format": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦That image format is not supported. This app analyses JPEG, PNG, and HEIC images. · That image format is not supported. This app analyses JPEG, PNG, and HEIC images.⟧"
          }
        }
      }
    },
    "copy.apparent-inconsistency": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The two checks above point in different directions. Both are shown exactly as they were found. This app does not decide between them. · The two checks above point in different directions. Both are shown exactly as they were found. This app does not decide between them.⟧"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.original-bytes": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦The exact file you chose was analysed, with no changes. · The exact file you chose was analysed, with no changes.⟧"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.platform-transformed-copy": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦iOS supplied a converted copy rather than the original file. Converting an image can remove the patterns this app looks for, so treat this result with extra caution. · iOS supplied a converted copy rather than the original file. Converting an image can remove the patterns this app looks for, so treat this result with extra caution.⟧"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦This app could not confirm whether it received the original file or a converted copy. If it was converted, some patterns may have been lost. · This app could not confirm whether it received the original file or a converted copy. If it was converted, some patterns may have been lost.⟧"
          }
        }
      }
    },
    "copy.chrome.analysis-in-progress-status": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Expanded to roughly twice the English length so a layout that only fits English fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "en-x-expand": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Analyzing this image on your device · Analyzing this image on your device⟧"
