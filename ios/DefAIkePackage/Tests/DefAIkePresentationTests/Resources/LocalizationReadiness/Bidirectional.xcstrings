          }
        }
      }
    },
    "copy.combined-summary.inconclusive": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار نتيجة مجمعة⁩"}}}},
    "copy.combined-summary.mixed-evidence": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار أدلة مختلطة⁩"}}}},
    "copy.combined-summary.no-strong-ai-signal": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار إشارة بكسل⁩"}}}},
    "copy.combined-summary.no-strong-ai-signal-with-credential": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار إشارة مع بيانات⁩"}}}},
    "copy.combined-summary.signs-of-ai-credential-unresolved": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار إشارة وبيانات غير محسومة⁩"}}}},
    "copy.combined-summary.signs-of-ai-without-credential": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار إشارة بدون بيانات⁩"}}}},
    "copy.combined-summary.validated-credential-pixel-inconclusive": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار بيانات متحققة⁩"}}}},
    "copy.provenance-detail.assertion-labels": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار ادعاء بيانات⁩"}}}},
    "copy.provenance-detail.claim-generator": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار منشئ بيانات⁩"}}}},
    "copy.provenance-detail.signer-identity": {"extractionState":"manual","localizations":{"ar-x-bidi":{"stringUnit":{"state":"translated","value":"⁧اختبار موقع بيانات⁩"}}}},
    "copy.correction-channel": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] You can report a result that looks wrong. Your image is never included in a report.⁩"
          }
        }
      }
    },
    "copy.error-recovery.calibration-input-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose an image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.decoding-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose another image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.handoff-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Share the image again, or choose it from your photos to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.inference-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose an image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.invalid-output-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose an image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.model-load-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose an image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.preprocessing-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose another image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.resource-limit": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Close other apps to free up memory, then choose an image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.unsupported-media": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose a still image to start again.⁩"
          }
        }
      }
    },
    "copy.error-recovery.unsupported-static-format": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Choose a JPEG, PNG, or HEIC image to start again.⁩"
          }
        }
      }
    },
    "copy.evidence-scope": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This app looks for signs that an entire image was generated. It does not detect edited regions, composites, face swaps, retouching, video, or audio, and it does not identify which tool was used.⁩"
          }
        }
      }
    },
    "copy.false-result-limitation": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Both kinds of mistake happen. A real photograph can be reported as showing AI signals, and an AI-generated image can be reported as showing none. Do not rely on this result on its own.⁩"
          }
        }
      }
    },
    "copy.model-information": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] One model runs on your device. It is not perfect, and it is never updated over the network.⁩"
          }
        }
      }
    },
    "copy.pixel-explanation.no-strong-signal-detected": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This app did not find the patterns it looks for. That is not a finding that the image is real or unedited. Resaving, cropping, or screenshotting an image can remove those patterns, so an AI-generated image can also look like this.⁩"
          }
        }
      }
    },
    "copy.pixel-explanation.not-enough-signal": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] There was not enough usable signal in this image to report either way. Heavy compression, a small image, or a screenshot can all cause this.⁩"
          }
        }
      }
    },
    "copy.pixel-explanation.signals-consistent-with-ai-generation": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This image contains patterns that often appear in images generated entirely by AI. That is not proof of how it was made. This app cannot tell you who made it, what it was made for, or whether any part of it was edited.⁩"
          }
        }
      }
    },
    "copy.pixel-label.no-strong-signal-detected": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] No strong signal detected⁩"
          }
        }
      }
    },
    "copy.pixel-label.not-enough-signal": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Not enough signal⁩"
          }
        }
      }
    },
    "copy.pixel-label.signals-consistent-with-ai-generation": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Signals consistent with AI generation⁩"
          }
        }
      }
    },
    "copy.privacy-explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Your image is analysed on this device. It is never uploaded, saved, or shared.⁩"
          }
        }
      }
    },
    "copy.provenance-state.absent": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This image carries no Content Credential. Most images do not, so this says nothing about how the image was made.⁩"
          }
        }
      }
    },
    "copy.provenance-state.indeterminate": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This app could not finish checking this image's Content Credential, so there is no result from that source.⁩"
          }
        }
      }
    },
    "copy.provenance-state.invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This image carries a Content Credential that does not match the bytes analysed. The image may have been changed after it was signed, or the credential may have been altered.⁩"
          }
        }
      }
    },
    "copy.provenance-state.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This image carries credential data that this app cannot read.⁩"
          }
        }
      }
    },
    "copy.provenance-state.validated": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This image carries a Content Credential that matches the exact bytes analysed. That confirms the credential belongs to these bytes. It does not confirm that what the credential says about the image is true.⁩"
          }
        }
      }
    },
    "copy.provenance-unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This version cannot check Content Credentials. That is a limit of the installed app, not a finding about the image.⁩"
          }
        }
      }
    },
    "copy.screenshot-provenance-explanation": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Taking a screenshot creates a new image and usually removes any Content Credential the original had. A missing credential on a screenshot tells you nothing about the original image.⁩"
          }
        }
      }
    }
  },
  "version": "1.0"
}
