{
  "sourceLanguage": "ar-x-bidi",
  "strings": {
    "copy.analysis-error.calibration-input-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The result could not be turned into one of this app's three labels, so no result is being shown.⁩"
          }
        }
      }
    },
    "copy.analysis-error.decoding-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] That image could not be read. The file may be incomplete or damaged.⁩"
          }
        }
      }
    },
    "copy.analysis-error.handoff-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The image shared from the other app did not arrive intact, so it was not analysed.⁩"
          }
        }
      }
    },
    "copy.analysis-error.inference-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The analysis did not finish running on this device, so no result was produced.⁩"
          }
        }
      }
    },
    "copy.analysis-error.invalid-output-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The model returned something this app could not use, so no result is being shown.⁩"
          }
        }
      }
    },
    "copy.analysis-error.model-load-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The on-device model could not be loaded, so no analysis ran.⁩"
          }
        }
      }
    },
    "copy.analysis-error.preprocessing-error": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The image could not be prepared for analysis, so no result was produced.⁩"
          }
        }
      }
    },
    "copy.analysis-error.resource-limit": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Analysis stopped because it needed more memory or time than this app is allowed to use on this device.⁩"
          }
        }
      }
    },
    "copy.analysis-error.unsupported-media": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] That file is not a still image, so there was nothing for this app to analyse.⁩"
          }
        }
      }
    },
    "copy.analysis-error.unsupported-static-format": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] That image format is not supported. This app analyses JPEG, PNG, and HEIC images.⁩"
          }
        }
      }
    },
    "copy.apparent-inconsistency": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The two checks above point in different directions. Both are shown exactly as they were found. This app does not decide between them.⁩"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.original-bytes": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] The exact file you chose was analysed, with no changes.⁩"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.platform-transformed-copy": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] iOS supplied a converted copy rather than the original file. Converting an image can remove the patterns this app looks for, so treat this result with extra caution.⁩"
          }
        }
      }
    },
    "copy.byte-preservation-limitation.unknown": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] This app could not confirm whether it received the original file or a converted copy. If it was converted, some patterns may have been lost.⁩"
          }
        }
      }
    },
    "copy.chrome.analysis-in-progress-status": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Analyzing this image on your device⁩"
          }
        }
      }
    },
    "copy.chrome.cancellation-action": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Stop analyzing⁩"
          }
        }
      }
    },
    "copy.chrome.cancelled-status": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] You stopped the analysis, so there is no result⁩"
          }
        }
      }
    },
    "copy.chrome.development-build-notice": {
      "comment": "Localization Readiness Suite test copy. Never shipped. Right-to-left isolate around mixed-direction text so a layout or reading order that assumes left-to-right fails visibly.",
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
          "stringUnit": {
            "state": "translated",
            "value": "⁧[عربي] Development build. Its calibration is not approved, so nothing below is a verdict about any image.⁩"
          }
        }
      }
    },
    "copy.chrome.disclosure-collapsed-state": {
      "extractionState": "manual",
      "localizations": {
        "ar-x-bidi": {
